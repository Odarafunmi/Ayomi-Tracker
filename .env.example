# ── Supabase (optional) ──────────────────────────────────────────────────────
# When these are set, Ayomi Tracker signs users in with Supabase Auth (email
# magic link) and stores profiles/cycles in Supabase Postgres under Row Level
# Security. When they are NOT set, the app runs in local demo mode and keeps
# data in the browser (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only (used by the edge function, never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Ayomi Tracker <reminders@yourdomain.com>"
